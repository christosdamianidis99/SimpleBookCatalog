@using Microsoft.AspNetCore;
@page "/login"
@inject SimpleBookCatalogDbContext dbContext
@inject NavigationManager navigationManager
<div class="row">
    <div class="col-lg-4 offset-lg-4 pt-4 pb-4 border">
        <EditForm Model="@Model" OnValidSubmit="Authenticate" FormName="LoginForm">
            <DataAnnotationsValidator />

            <div class="mb-3 text-center flex-column">
                <img src="/images/avatar_transparent.png" style="max-height:5rem; background-color: #f8f9fa; border-radius: 50%; padding: 10px;" />
                <h3>LOGIN</h3>
            </div>
            <div class="mb-3">
                <label>User Name</label>
                <InputText @bind-Value="Model.EmailOrUsername" class="form-control" placeholder="Username" />
                <ValidationMessage For="()=>Model.EmailOrUsername" />
            </div>

            <div class="mb-3">
                <label>Password</label>
                <InputText id="passwordInput" @bind-Value="Model.Password" placeholder="Password" type="@passwordInputType" class="form-control" />
                <ValidationMessage For="()=>Model.Password" />
            </div>

            <div class="form-check mb-3">
                <input type="checkbox" class="form-check-input" id="showPasswordCheckbox" onclick="togglePasswordVisibility()">
                <label class="form-check-label" for="showPasswordCheckbox">Show Password</label>
            </div>

            <div class="mb-3 text-center">
                <span class="text-danger">@errorMessage</span>
            </div>
            <div class="mb-3 d-grid gap-2">
                <button type="submit" class="btn btn-primary">Login</button>
            </div>
        </EditForm>

        <button class="gsi-material-button" onclick="window.location.href='/Account/GoogleLogin'">
            <div class="gsi-material-button-state"></div>
            <div class="gsi-material-button-content-wrapper">
                <div class="gsi-material-button-icon">
                    <svg version="1.1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" xmlns:xlink="http://www.w3.org/1999/xlink" style="display: block;">
                        <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"></path>
                        <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"></path>
                        <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"></path>
                        <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"></path>
                        <path fill="none" d="M0 0h48v48H0z"></path>
                    </svg>
                </div>
                <span class="gsi-material-button-contents">Sign in with Google</span>
                <span style="display: none;">Sign in with Google</span>
            </div>
        </button>
    </div>
</div>

@code {
    [CascadingParameter]
    public HttpContext? httpContext { get; set; }

    [SupplyParameterFromForm]
    public LoginViewModel Model { get; set; } = new();

    private string passwordInputType = "password"; // Default type for password input
    private string? errorMessage;

    private void TogglePasswordVisibility(ChangeEventArgs e)
    {
        // Toggle between 'text' and 'password' for the input type
        passwordInputType = (bool)e.Value ? "text" : "password";
    }

    private async Task Authenticate()
    {
        var userAccount = dbContext.UserAccounts
            .FirstOrDefault(x => x.UserName == Model.EmailOrUsername);

        if (userAccount is null || userAccount.Password != Model.Password)
        {
            errorMessage = "Invalid User Name or Password";
            return;
        }
        if (!userAccount.IsVerified)
        {
            errorMessage = "Please verify your email before logging in.";
            return;
        }

        var claims = new List<Claim>
        {
            new Claim(ClaimTypes.Name, Model.EmailOrUsername),
            new Claim(ClaimTypes.Role, userAccount.Role)
        };
        var identity = new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme);
        var principal = new ClaimsPrincipal(identity);

        await httpContext.SignInAsync(principal);
        navigationManager.NavigateTo("/");
    }
}