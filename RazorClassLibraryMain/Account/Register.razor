@page "/register"
@using RazorClassLibraryMain.EmailVerificationClasses
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@rendermode InteractiveServer

@inject SimpleBookCatalogDbContext dbContext
@inject NavigationManager navigationManager

<div class="row">
    <div class="col-lg-4 offset-lg-4 pt-4 pb-4 border">
        <EditForm Model="@Model" FormName="RegisterForm" OnValidSubmit="RegisterUser">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label>Username</label>
                <InputText @bind-Value="Model.Username" class="form-control" placeholder="Enter username" />
                <ValidationMessage For="()=>Model.Username" />
            </div>

            <div class="mb-3">
                <label>Email</label>
                <InputText @bind-Value="Model.Email" class="form-control" placeholder="Enter email" />
                <ValidationMessage For="()=>Model.Email" />
            </div>

            <div class="mb-3">
                <label>Password</label>
                <InputText @bind-Value="Model.Password" type="password" class="form-control" placeholder="Enter password" />
                <ValidationMessage For="()=>Model.Password" />
            </div>

            <div class="mb-3">
                <label>Confirm Password</label>
                <InputText @bind-Value="Model.ConfirmPassword" type="password" class="form-control" placeholder="Confirm password" />
                <ValidationMessage For="()=>Model.ConfirmPassword" />
            </div>

            <div class="mb-3 text-center">
                <span class="text-danger">@errorMessage</span>
            </div>
            <div class="mb-3 d-grid gap-2">
                <button type="submit" class="btn btn-primary">Register</button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    public RegisterViewModel Model { get; set; } = new();
    private string? errorMessage;

    private async Task RegisterUser()
    {
        if (dbContext.UserAccounts.Any(x => x.UserName == Model.Username || x.Email == Model.Email))
        {
            errorMessage = "User already exists.";
            return;
        }

        // Generate a verification token
        var verificationToken = Guid.NewGuid().ToString();

        // Create a new user
        var newUser = new UserAccount
            {
                UserName = Model.Username,
                Email = Model.Email,
                Password = Model.Password, // Hash this in production
                Role = "User",
                IsVerified = false,
                VerificationToken = verificationToken
            };

        // Add the user to the database
        dbContext.UserAccounts.Add(newUser);
        await dbContext.SaveChangesAsync();

        // Generate a verification link using the current base URL
        var verificationLink = $"{navigationManager.BaseUri}verify?token={verificationToken}";

        // Send the verification email
        await EmailHelper.SendVerificationEmailAsync(Model.Email, verificationLink);

        // Show a message to the user
        errorMessage = "Registration successful. Please check your email to verify your account.";
    }

}
