@using Microsoft.EntityFrameworkCore;


@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject SimpleBookCatalogDbContext dbContext
@inject IHttpContextAccessor HttpContextAccessor

<div class="layout-container">
    <aside class="sidebar">

        <!-- Main Page link solo at the top -->
        <section class="sidebar-section">
            <h2 class="sidebar-title">
                <a class="text-decoration-none text-light" href="/">Main Page</a>
            </h2>
        </section>

        <!-- Role-based Navigation -->
        <AuthorizeView Roles="Administrator,User">
            <Authorized>
                <section class="sidebar-section">
                    <ul class="sidebar-list">
                        <li><a href="/show-authors">Authors</a></li>
                        <li><a href="/show-publishers">Publishers</a></li>
                        <li><a href="/show-genres">Genres</a></li>
                        <li><a href="/show-books">Books</a></li>
                        <li><a href="/filter-books-authors">Filter books</a></li>
                        <li><a href="/my-account">My Account</a></li>


                    </ul>
                </section>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="Administrator">
            <Authorized>
                <section class="sidebar-section">
                    <ul class="sidebar-list">
                        <li><a href="/book-chart">Books Chart</a></li>
                        <li><a href="/genre-chart">Genre Chart</a></li>
                    </ul>
                </section>
            </Authorized>
        </AuthorizeView>

    </aside>

    <main class="main-content">
        <article class="content pt-5">
            @Body
        </article>
    </main>

    <!-- Authorization Section (Bottom Left) -->
    <AuthorizeView>
        <Authorized>
            <!-- Logged-in Section -->
            <div class="auth-status-logout bg-white text-dark p-2 rounded shadow-sm">
                <span>Welcome, you are logged in as <b>@context.User.Identity.Name</b>!</span>
                <a class="btn btn-danger btn-sm fw-bold mt-2 d-block text-center" href="/logout">Logout</a>
            </div>
        </Authorized>
        <NotAuthorized>
            <!-- Logged-out Section -->
            <div class="auth-status-login bg-light text-dark p-2 rounded shadow-sm">
                <div class="d-flex justify-content-between">
                    <a class="btn btn-primary btn-sm fw-bold me-2" href="/login">Login</a>
                    <a class="btn btn-secondary btn-sm fw-bold" href="/register">Register</a>
                </div>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

<style>
    .auth-status-logout {
        position: fixed;
        top: 20px;
        left: 20px;
        width: 300px;
        z-index: 1000;
    }

    .auth-status-login {
        position: fixed;
        top: 20px;
        left: 20px;
        width: auto; /* Adjust width for both buttons */
        z-index: 1000;
    }

        .auth-status-login .btn {
            width: 100px; /* Ensure consistent button sizes */
        }
</style>
@code {
    private bool userExists = true;
    private string? userName;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userName = authState.User.Identity?.Name;


        if (!string.IsNullOrEmpty(userName))
        {
            // Check if the user exists in the database
            userExists = await dbContext.UserAccounts.AnyAsync(u => u.UserName == userName);

            if (!userExists)
            {
                // Force logout and redirect to the login page
                await LogoutUser();
                RedirectToLogin();
            }
        }
    }

    private async Task LogoutUser()
    {
        var httpContext = HttpContextAccessor.HttpContext;

        if (httpContext != null)
        {
            await AuthenticationHttpContextExtensions.SignOutAsync(httpContext, CookieAuthenticationDefaults.AuthenticationScheme);
        }
    }

    private void RedirectToLogin()
    {
        NavigationManager.NavigateTo("/login", true);
    }
}